# Kali NetHunter overlay for rock, applied on top of gki_defconfig + rock.fragment.
#
# The flashable zip replaces only Image, so ROM modules have to keep loading.
# Do not enable anything that changes the KMI here: SYSVIPC, USER_NS, PID_NS and
# CGROUP_DEVICE/CGROUP_PIDS alter task_struct or the cgroup subsystem ids.
# build_nethunter.sh verifies the result against the ROM modules.
#
# Image only gains KernelSU-Next (plus the f_hid fix in the source tree).
# Drivers for external USB adapters are =m and ship in the KSU module, keeping
# the Image config as close to stock UndergroundKernel as possible.
# Never select MAC80211_LEDS or CFG80211_* options: cfg80211 and mac80211 are
# ROM modules and their struct layout has to match what our modules see.

CONFIG_LOCALVERSION="-UndergroundKernel-NetHunter"

# KernelSU-Next
CONFIG_KSU=y

# ---- USB Wi-Fi adapters ----
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=m
CONFIG_CARL9170=m
CONFIG_AR5523=m
CONFIG_ATH6KL=m
CONFIG_ATH6KL_USB=m
CONFIG_WLAN_VENDOR_ATMEL=y
CONFIG_AT76C50X_USB=m
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_USB=y
# CONFIG_BRCMFMAC_SDIO is not set
CONFIG_WLAN_VENDOR_INTERSIL=y
CONFIG_P54_COMMON=m
CONFIG_P54_USB=m
CONFIG_WLAN_VENDOR_MARVELL=y
CONFIG_LIBERTAS=m
CONFIG_LIBERTAS_USB=m
CONFIG_LIBERTAS_THINFIRM=m
CONFIG_LIBERTAS_THINFIRM_USB=m
CONFIG_MWIFIEX=m
CONFIG_MWIFIEX_USB=m
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=m
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m
CONFIG_MT7663U=m
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=m
CONFIG_RT2500USB=m
CONFIG_RT73USB=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8187=m
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_WLAN_VENDOR_ZYDAS=y
CONFIG_ZD1211RW=m
CONFIG_USB_NET_RNDIS_WLAN=m

# ---- USB Bluetooth adapters ----
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_ATH3K=m
CONFIG_BT_HCIBCM203X=m
CONFIG_BT_HCIBPA10X=m
CONFIG_BT_HCIBFUSB=m
CONFIG_BT_BNEP=m

# ---- SDR ----
# RTL-SDR, HackRF, Airspy, LimeSDR and bladeRF work from userspace through
# libusb and need no kernel driver. The V4L2 SDR drivers below are opt-in in the
# KSU module: once bound they keep libusb tools from claiming the device. DVB
# (dvb_usb_rtl28xxu) is left out for the same reason.
CONFIG_MEDIA_SDR_SUPPORT=y
CONFIG_USB_AIRSPY=m
CONFIG_USB_HACKRF=m

# ---- USB serial and network adapters (PlutoSDR, ESP32/Arduino, UART probes) ----
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USB_NET_RNDIS_HOST=m
